[Unit]
Description=Pickle Telegram Connector & Low-Latency Watcher Service
Documentation=https://github.com/yjj3019/pickle-telegram-connector
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pickle-telegram-connector
ExecStart=/usr/bin/python3 -m pickle_tg.cli daemon
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=10

# Security hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only

# Configuration
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-/opt/pickle-telegram-connector/config/env

[Install]
WantedBy=multi-user.target
