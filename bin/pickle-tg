#!/usr/bin/env python3
"""Executable entrypoint for Pickle Telegram Connector."""
import os
import sys

# Add parent directory to sys.path so pickle_tg is importable directly
script_dir = os.path.dirname(os.path.abspath(__file__))
project_root = os.path.dirname(script_dir)
if project_root not in sys.path:
    sys.path.insert(0, project_root)

from pickle_tg.cli import main

if __name__ == "__main__":
    sys.exit(main())
